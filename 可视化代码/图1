import os
import matplotlib.pyplot as plt
from matplotlib import font_manager
from matplotlib.colors import LinearSegmentedColormap
def choose_chinese_font():
	"""Select an installed font that can render the Chinese labels."""
	preferred_fonts = ["Microsoft YaHei", "SimHei", "DengXian", "Noto Sans CJK SC"]
	installed_fonts = {font.name for font in font_manager.fontManager.ttflist}
	for font_name in preferred_fonts:
		if font_name in installed_fonts:
			return font_name
	return "DejaVu Sans"
def main():
	regions = ["华北", "华南", "东北", "西北", "西南", "华东"]
	sales = [2354, 1902, 3524, 2698, 2896, 2563]
	font_name = choose_chinese_font()
	plt.rcParams["font.family"] = font_name
	plt.rcParams["axes.unicode_minus"] = False
	background = "#1d234a"
	figure, axis = plt.subplots(figsize=(8.61, 6.22), dpi=100)
	figure.patch.set_facecolor(background)
	axis.set_facecolor(background)
	x_positions = range(len(regions))
	bar_width = 0.30
	gradient = LinearSegmentedColormap.from_list(
		"bar_gradient", ["#087dc4", "#08b2e8"]
	)
	bars = axis.bar(
		x_positions,
		sales,
		width=bar_width,
		color="#079ddd",
		edgecolor="none",
		zorder=3,
	)
	# Paint each bar with a subtle vertical blue gradient.
	for bar in bars:
		x_left = bar.get_x()
		x_right = x_left + bar.get_width()
		height = bar.get_height()
		axis.imshow(
			[[gradient(0.0)], [gradient(1.0)]],
			extent=(x_left, x_right, 0, height),
			aspect="auto",
			interpolation="bicubic",
			zorder=4,
			clip_path=bar,
			clip_on=True,
		)
	axis.set_ylim(0, 4000)
	axis.set_xlim(-0.45, len(regions) - 0.55)
	axis.set_xticks(list(x_positions), regions, color="white", fontsize=14)
	axis.set_yticks([0, 1000, 2000, 3000, 4000])
	axis.tick_params(axis="x", length=0, pad=9)
	axis.tick_params(axis="y", colors="white", labelsize=11, length=0, pad=8)
	axis.grid(
		axis="y",
		color="#858aa8",
		linestyle=(0, (9, 6)),
		linewidth=1.2,
		alpha=0.45,
		zorder=1,
	)
	for spine in axis.spines.values():
		spine.set_visible(False)
	figure.text(
		0.078,
		0.86,
		"3月各区域销量分布",
		color="white",
		fontsize=28,
		fontweight="bold",
	)
	figure.text(
		0.078,
		0.778,
		"东北销量最多占比总销量的22%，华南销量最低",
		color="white",
		fontsize=21,
	)
	for x_position, value in zip(x_positions, sales):
		axis.text(
			x_position,
			value + 120,
			str(value),
			ha="center",
			va="bottom",
			color="white",
			fontsize=11,
			zorder=5,
		)
	figure.text(
		0.058,
		0.045,
		"*注：数据来源于公司销售系统，统计日期截至2022.03.31",
		color="white",
		fontsize=11,
	)
	figure.subplots_adjust(left=0.145, right=0.91, top=0.70, bottom=0.155)
	plt.show()
if __name__ == "__main__":
	main()